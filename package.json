{
  "name": "motionforge-remotion-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Separate Node.js service that bundles and renders Remotion projects submitted by MotionForge Studio.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.300",
    "@remotion/renderer": "^4.0.300",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "jszip": "^3.10.1",
    "nanoid": "^5.0.9",
    "remotion": "^4.0.300"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
