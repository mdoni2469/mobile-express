# Port the worker listens on
PORT=8787

# Shared secret the frontend must send as `Authorization: Bearer <token>`
# on every /api/render request. Generate a long random string.
WORKER_AUTH_TOKEN=

# Supabase project used to upload render output and verify end-user JWTs.
# SUPABASE_SERVICE_ROLE_KEY is required here (server-side only) because
# the worker writes to the private motionforge-exports bucket on behalf
# of users — it must NEVER be shipped to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resource limits (see src/security.ts for enforcement)
MAX_UPLOAD_ZIP_BYTES=104857600
MAX_RENDER_SECONDS=120
RENDER_TIMEOUT_MS=600000
WORKSPACE_DIR=/tmp/motionforge-renders
